# ============================================
# DT Tracker - 백엔드 환경변수 예시
# 이 파일을 복사해서 .env로 저장 후 실제 값 입력
# .env 파일은 절대 Git에 커밋하지 말 것
# ============================================

# 서버
NODE_ENV=development
PORT=4000

# 데이터베이스 (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dt_tracker
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# JWT 인증
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=8h

# Anthropic AI API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# SSO (SAML 2.0)
SAML_ENTRY_POINT=https://your-idp.hanon.com/saml/login
SAML_ISSUER=dt-tracker
SAML_CERT=your_saml_certificate_here

# 이메일 알림 (선택)
SMTP_HOST=smtp.hanon.com
SMTP_PORT=587
SMTP_USER=dt-tracker@hanon.com
SMTP_PASSWORD=your_smtp_password

# CORS
CORS_ORIGIN=http://localhost:3000

# ── 운영 에이전트 (Ops Agent) ──────────────────────────
# 운영/유지보수 자동 감시 에이전트 활성화 여부
OPS_AGENT_ENABLED=false
# 진단/질의에 사용할 모델 (기본: claude-opus-4-8)
OPS_AGENT_MODEL=claude-opus-4-8
# critical 알림 수신 이메일 (쉼표 구분)
OPS_ALERT_EMAILS=
# warning 이상 알림을 보낼 웹훅 (Slack/Teams Incoming Webhook 등)
OPS_WEBHOOK_URL=
